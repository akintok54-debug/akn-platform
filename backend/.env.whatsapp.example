# ==========================================================
# AKN - WhatsApp Provider Configuration Template
# Copy this file to .env and fill values.
# ==========================================================

PORT=5000
MONGO_URI=
JWT_SECRET=

# Public dealer portal base URL shown to customers
DEALER_PORTAL_BASE_URL=https://erp.akncloud.com

# Public backend API URL used for PDF media link in WhatsApp payload
PUBLIC_API_BASE_URL=https://api.akncloud.com

# ----------------------------------------------------------
# WhatsApp Provider Selection
# none | meta | twilio
# ----------------------------------------------------------
WHATSAPP_PROVIDER=meta
WHATSAPP_DEFAULT_COUNTRY_CODE=90

# ----------------------------------------------------------
# Meta WhatsApp Cloud API
# ----------------------------------------------------------
WHATSAPP_META_TOKEN=
WHATSAPP_META_PHONE_NUMBER_ID=

# ----------------------------------------------------------
# Twilio WhatsApp API
# ----------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
